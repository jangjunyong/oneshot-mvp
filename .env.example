# 복사해서 .env.local 로 쓴다. .env.local 은 커밋되지 않는다.
#
# 한국관광공사 TourAPI 키 — https://www.data.go.kr 에서 발급
TOUR_API_KEY=

# 국토부 브이월드 키 — https://www.vworld.kr 오픈API 인증키.
# 도면 배경(백지도)에 쓴다. 서버가 읽어 화면에 넘긴다.
# 실측상 리퍼러 제한이 느슨한 키라 저장소에 하드코딩하지 않는다.
# 비우면 OSM 폴백으로 뜬다 — 화면은 살고, 화질만 떨어진다.
VWORLD_KEY=

# 기획안 파싱에 쓸 OpenRouter 키 — https://openrouter.ai/keys
#
# 이 값을 비워두면 모델을 아예 부르지 않고 고정 샘플 초안으로 떨어진다.
# 화면을 만드는 동안은 비워두는 것이 맞다.
#
# **유료 모델을 쓴다** (2026-08-31). 무료 모델이 계속 429 를 뱉었는데,
# 1차 심사는 심사위원이 직접 이 버튼을 누르는 기능심사라 첫 관문이
# 실패하면 안 된다. 기본값은 google/gemini-2.5-flash-lite (약 1.1원/건).
#
# 비용은 셋으로 잠겨 있다 — 입력 8,000자 · 응답 700토큰 · 하루 45건.
# 최악이라도 하루 50원 안쪽이다. 그래도 배포본은 로그인이 없으므로
# **오픈라우터 대시보드에서 키별 지출 상한을 반드시 걸 것.**
OPENROUTER_API_KEY=

# 비우면 lib/extract.ts 의 기본값을 쓴다. 갈아끼울 때만 적는다.
# 2026-08-31 실측 (같은 김천 기획서):
#   google/gemini-2.5-flash-lite   1.0초  5축 정확   약 1.1원/건  <- 기본값
#   upstage/solar-pro4            15.0초  5축 정확   약 0.3원/건
#   openai/gpt-oss-120b           16.2초  대부분 못 뽑음
#   openai/gpt-5-nano                 —   우리 스키마를 거절(400)
OPENROUTER_MODEL=
