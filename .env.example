# 복사해서 .env.local 로 쓴다. .env.local 은 커밋되지 않는다.
#
# 한국관광공사 TourAPI 키 — https://www.data.go.kr 에서 발급
TOUR_API_KEY=

# 기획안 파싱에 쓸 OpenRouter 키 — https://openrouter.ai/keys
#
# 이 값을 비워두면 모델을 아예 부르지 않고 고정 샘플 초안으로 떨어진다.
# 화면을 만드는 동안은 비워두는 것이 맞다.
#
# 기본 모델은 무료다(z-ai/glm-5.2:free). 크레딧을 넣지 않으면 청구가
# 불가능하고, 대신 하루 50건에서 막힌다. 코드는 45건에서 먼저 끊는다.
OPENROUTER_API_KEY=

# 비우면 무료 모델을 쓴다. 추출 품질이 모자랄 때만 갈아끼운다.
#   z-ai/glm-5.2:free                     0원   (기본값)
#   nvidia/nemotron-3-super-120b-a12b:free 0원
#   google/gemini-3.7-flash               약 3원/건
#   anthropic/claude-sonnet-5             약 16원/건
# 유료로 바꿀 때는 오픈라우터에서 **키별 지출 상한**을 같이 걸 것.
OPENROUTER_MODEL=
